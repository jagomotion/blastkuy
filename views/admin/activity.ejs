<div class="page-header">
  <h1>Aktivitas Pesan</h1>
  <p>500 aktivitas pengiriman pesan terakhir dari semua user</p>
</div>

<div class="card">
  <% if (messages.length === 0) { %>
    <p class="muted empty">Belum ada aktivitas</p>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>Waktu</th>
            <th>User</th>
            <th>Email</th>
            <th>Nomor Tujuan</th>
            <th>Via Akun</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% messages.forEach(function(m) { %>
          <tr>
            <td><small><%= new Date(m.sentAt).toLocaleString('id-ID') %></small></td>
            <td><%= m.userName %></td>
            <td><small class="muted"><%= m.userEmail %></small></td>
            <td><%= m.customerPhone %></td>
            <td><%= m.accountPhone || '-' %></td>
            <td>
              <span class="badge badge-<%= m.status === 'sent' ? 'approved' : 'rejected' %>">
                <%= m.status %>
              </span>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>